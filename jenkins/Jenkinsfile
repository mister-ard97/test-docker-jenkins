pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    parameters {
        booleanParam(
            name: 'PUSH_IMAGE',
            defaultValue: true,
            description: 'Push image ke Docker Hub'
        )
    }

    environment {
        APP_NAME          = 'devops-app'
        BASE_VERSION      = '1.0.1'
        CONTAINER         = 'devops-app'
        // Jenkins ada di container: port 8080 milik host diakses via host.docker.internal
        APP_URL           = 'http://host.docker.internal:8080/'
        BUILDKIT_PROGRESS = 'plain'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    def sha = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                    env.APP_VERSION = "${env.BASE_VERSION}-${sha}"
                    env.IMAGE = "${env.APP_NAME}:${env.APP_VERSION}"
                }
                echo "Versi build: ${env.APP_VERSION}"
            }
        }

        stage('Test') {
            steps {
                // Menjalankan go test ./... (stage "test" di Dockerfile)
                sh 'docker build --target test --no-cache -t "$APP_NAME:test" .'
            }
        }

        stage('Build Image') {
            steps {
                sh 'docker build --build-arg VERSION="$APP_VERSION" -t "$IMAGE" .'
            }
        }

        stage('Push') {
            when { expression { params.PUSH_IMAGE } }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'REG_USER',
                    passwordVariable: 'REG_PASS'
                )]) {
                    sh '''
                        echo "$REG_PASS" | docker login -u "$REG_USER" --password-stdin
                        docker tag "$IMAGE" "$REG_USER/$IMAGE"
                        docker push "$REG_USER/$IMAGE"
                        docker logout
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    # Ambil binary dari image yang baru di-build (tanpa build ulang)
                    rm -rf build && mkdir -p build
                    cid=$(docker create "$IMAGE")
                    docker cp "$cid:/app/myapp" build/myapp
                    docker rm "$cid" > /dev/null
                    if docker container inspect "$CONTAINER" > /dev/null 2>&1; then
                        bash scripts/swap-binary.sh "$CONTAINER" build/myapp \
                            "$APP_VERSION" "$APP_URL"
                    else
                        echo "Container belum ada: deploy pertama langsung dari image"
                        docker run -d --name "$CONTAINER" -p 8080:8080 \
                            --restart unless-stopped "$IMAGE"
                    fi
                '''
            }
        }
    }

    post {
        success {
            echo "Deploy sukses: ${env.IMAGE}"
        }
        failure {
            echo 'Pipeline GAGAL. Lihat stage yang merah.'
        }
    }
}